# EduAI Prism「鲁班 7 号」环境变量示例 —— 复制为 .env.local 并按需填写。

# 【生产必填】会话签名密钥（HMAC-SHA256）。生产环境若缺失或仍为默认 dev 值，应用会 fail-fast 拒绝启动。
# 生成：openssl rand -base64 48
EDUAI_SESSION_SECRET=

# 【公网反向代理建议】浏览器可见的唯一站点源，用于写请求来源校验，例如 https://edu.example.edu.cn。
# EDUAI_PUBLIC_ORIGIN=https://edu.example.edu.cn

# Optional demo data seeding. Non-production defaults to enabled for local demos;
# production defaults to disabled unless explicitly set to true.
# EDUAI_ENABLE_DEMO_SEED=false

# 【生产首次启动】空库会用下面三项创建唯一的初始管理员；数据库已有用户后不会再次执行。
# 若空库且未配置，/api/health/ready 返回 503，避免“服务健康但无人可登录”。
EDUAI_BOOTSTRAP_ADMIN_USERNAME=
EDUAI_BOOTSTRAP_ADMIN_PASSWORD=
EDUAI_BOOTSTRAP_ADMIN_NAME=学校管理员

# 【数据最小化】审计默认保留 365 天且最多 250000 条；按学校制度调整。
# EDUAI_AUDIT_RETENTION_DAYS=365
# EDUAI_AUDIT_MAX_ROWS=250000

# 【反向代理】仅当应用端口只对可信代理开放、且代理覆盖 X-Forwarded-For 时开启。
# EDUAI_TRUST_PROXY=true

# 【可选】大模型网关（OpenAI 兼容 /v1/chat/completions）。配置后 /api/chat 走真实模型；
# 未配置则走诚实本地兜底（演示可零外部依赖运行）。真实密钥请放 .env.local（已被 .gitignore 忽略），勿写入本示例。
LLM_API_KEY=
LLM_BASE_URL=https://api.llm-token.cn/v1

# 【可选】生图端点与逗号分隔的备用端点。仅服务端读取；生产环境仅接受 HTTPS。
LLM_IMAGE_BASE_URL=https://api.llm-token.cn/v1
LLM_IMAGE_API_KEY=
# LLM_FALLBACK_BASE_URLS=https://gpt-agent.cc/v1
EDUAI_LLM_ALLOWED_ORIGINS=https://api.llm-token.cn,https://gpt-agent.cc
EDUAI_IMAGE_MODEL=gpt-image-2

# 【部署可选】持久化数据库与生图资产目录。容器编排已默认映射为 /data。
# EDUAI_DB_DIR=.data
# EDUAI_ASSET_DIR=.data

# 【可选】对话模型代码覆盖（不填则按所选模型映射，缺省 gpt-5.4）。
# EDUAI_CHAT_MODEL=gpt-5.4
